#!/usr/bin/env bash
set -euo pipefail

readonly GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks:v8.30.1"

if ! command -v docker >/dev/null 2>&1; then
  echo "Erro: Docker nao encontrado." >&2
  exit 1
fi

echo "Obtendo o scanner de segredos fixado..."
docker pull "$GITLEAKS_IMAGE" &
pull_pid=$!
elapsed_seconds=0
while kill -0 "$pull_pid" 2>/dev/null; do
  if [ "$elapsed_seconds" -ge 120 ]; then
    kill "$pull_pid"
    wait "$pull_pid" || true
    echo "Erro: limite de 120 segundos ao obter o scanner." >&2
    exit 124
  fi
  sleep 1
  elapsed_seconds=$((elapsed_seconds + 1))
done
wait "$pull_pid"

echo "Verificando segredos no historico Git..."
docker run --rm --volume "$PWD:/repo:ro" --workdir /repo "$GITLEAKS_IMAGE" \
  git --no-banner --redact --timeout 120 .
